# OIDF Conformance Suite local runner settings.
#
# Copy to `.env` inside this directory for local overrides.
# Do not commit real hosted-suite credentials, client secrets, or production URLs.

# Use a released tag for reproducible evidence, or leave as `latest` while
# exploring current upstream behavior.
IMAGE_TAG=latest

# Default MongoDB image used by the official prebuilt compose file.
MONGODB_IMAGE=mongo:6.0.13

# The OIDF suite advertises this URL in generated callbacks. Keep the default
# unless you expose the suite through a public HTTPS name or tunnel.
BASE_URL=https://localhost.emobix.co.uk:8443

# The official prebuilt image uses the dev profile for local runs.
SPRING_PROFILES_ACTIVE=dev
