POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password
POSTGRES_DB=app_db
SATOIDC_PORT=8000
APP_ENV=development
DOMAIN=localhost
OAUTH2_JWT_ISS=http://localhost:8000
OAUTH2_JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
OAUTH2_TOKEN_EXPIRES_IN=300
OIDC_SIGNING_BACKEND=database
OIDC_TRANSIT_ADDR=
OIDC_TRANSIT_TOKEN=
OIDC_TRANSIT_MOUNT=transit
OIDC_TRANSIT_KEY_NAME=satoidc-id-token
EMAIL_SENDER_MODE=disabled
EMAIL_PUBLIC_BASE_URL=http://localhost:8000
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
EMAIL_RESET_TOKEN_TTL_SECONDS=1800
EMAIL_TOKEN_MIN_REQUEST_INTERVAL_SECONDS=60
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_START_TLS=false
SMTP_FROM_EMAIL=no-reply@satoidc.local
SESSION_MIDDLEWARE_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
SESSION_COOKIE_HTTPS_ONLY=false
